# Repository policy: keep source, question-bank JSON, logos, dependency manifests,
# lockfiles, and blank configuration examples. Keep local state out of Git.
# Ignore rules do not remove files from existing commits or Git history.

# Environment variables and local configuration (at every directory depth).
.env
.env.*
*.env
*.env.*
!.env.example
!.env.sample
!.env.template
.envrc
*.local
*.local.*
.npmrc
.pypirc
.netrc
_netrc
.git-credentials

# Credentials, private keys, and cloud/CLI authentication state.
secrets/
.secrets/
credentials/
.aws/
.azure/
.gcloud/
.kube/
**/.docker/config.json
credentials.json
credentials.*.json
secrets.json
secrets.*.json
service-account*.json
service_account*.json
*serviceAccount*.json
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*

# Application runtime data: accounts, profiles, submissions, and uploads.
# Do NOT ignore /data/: it contains the public interview question banks.
users.json
users.*.json
user_profiles.json
user_profiles.*.json
runtime/
instance/
uploads/
# Raw resumes (the tests generate fictional documents in memory).
*.pdf
*.docx
celerybeat-schedule*
sessions/
/backend/data/
/backend/storage/
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.dump
*.sql.gz

# JavaScript dependencies and package-manager caches.
node_modules/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/install-state.gz
.yarn/build-state.yml
.pnp.*
