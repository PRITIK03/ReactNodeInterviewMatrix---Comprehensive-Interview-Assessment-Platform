# Backend process environment reference. No secrets are required for the local demo.
# Set values in the service environment. Historic .env files are never loaded.
MATRIX_REVIEW_MODEL=
MATRIX_REVIEW_KEY=
REDIS_URL=
CLAMD_HOST=
CLAMD_PORT=3310

# Optional evaluation pricing. Supply current per-million-token model rates.
MATRIX_INPUT_USD_PER_M=
MATRIX_OUTPUT_USD_PER_M=
# Private service deployment. The local launcher starts its own SQLite workspace.
DATABASE_URL=
MATRIX_PUBLIC_ORIGIN=
MATRIX_RUNNER_ENDPOINT=
MATRIX_RUNNER_TOKEN=
